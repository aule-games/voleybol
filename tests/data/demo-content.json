          {
            "id": "q3-c1",
            "text": "Turkuaz 3 set alır"
          },
          {
            "id": "q3-c2",
            "text": "Maç berabere biter"
          },
          {
            "id": "q3-c3",
            "text": "Mercan 3, Turkuaz 1 set alır"
          },
          {
            "id": "q3-c4",
            "text": "Toplam 3 sayı oynanır"
          }
        ],
        "correctId": "q3-c3",
        "explanation": "Bu oyunda skorun ilk sayısı her zaman soldaki, yani ev sahibi takıma aittir."
      },
      {
        "id": "q4",
        "revision": 1,
        "text": "Aynı kurgusal oyuncuyu hayal takımında kaç kez seçebilirsin?",
        "choices": [
          {
            "id": "q4-c1",
            "text": "İki kez"
          },
          {
            "id": "q4-c2",
            "text": "Her yere"
