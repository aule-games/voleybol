          {
            "id": "q1-c3",
            "text": "Üç"
          },
          {
            "id": "q1-c4",
            "text": "Dört"
          }
        ],
        "correctId": "q1-c1",
        "explanation": "Demo takım şablonunda bir pasör yeri var. İki smaçör ve iki orta oyuncu seçiliyor."
      },
      {
        "id": "q2",
        "revision": 1,
        "text": "Bu demoda libero, takım görselinde nerede gösterilir?",
        "choices": [
          {
            "id": "q2-c1",
            "text": "Takımın dışında bırakılır"
          },
          {
            "id": "q2-c2",
            "text": "Ayrı bir libero alanında"
          },
          {
            "id": "q2-c3",
            "text": "İki farklı yerde"
          },
          {
            "id": "q2-c4",
            "text": "Kaleci alanında"
          }
        ],
        "correctId": "q2-c2",
        "explanation": "Görselde altı saha yeri ve ayrı bir libero alanı var. Bu, resmî bir rotasyon çizimi değil."
      },
      {
        "id": "q3",
        "revision": 1,
        "text": "Mercan – Turkuaz maçında “3-1” tahmini, bu oyunda ne anlama gelir?",
