      {
        "id": "q1",
        "revision": 1,
        "text": "Bu demoda yedi kişilik hayal takımında kaç pasör seçilir?",
        "choices": [
          {
            "id": "q1-c1",
            "text": "Bir"
          },
          {
            "id": "q1-c2",
            "text": "İki"
