        ],
        "correctId": "q4-c4",
        "explanation": "Yedi yer, yedi farklı oyuncuyla tamamlanır. Aynı oyuncu ikinci bir yere eklenemez."
      },
      {
        "id": "q5",
        "revision": 1,
        "text": "Bu prototipte tahminlerin nerede saklanır?",
