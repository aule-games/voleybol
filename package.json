{
  "name": "volleyball-fan-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": "26.8.1", "npm": "11.19.0" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "content:check": "node --experimental-strip-types scripts/check-content.ts",
    "demo:refresh": "node --experimental-strip-types scripts/demo-refresh.ts",
    "test": "vitest run",
    "build": "vite build",
    "verify": "npm run typecheck && npm run content:check && npm test && npm run build",
    "test:e2e": "playwright test",
    "measure:performance": "npm run build && node scripts/measure-performance.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
